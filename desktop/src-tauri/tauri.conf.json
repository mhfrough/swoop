{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swoop",
  "version": "0.1.0",
  "identifier": "dev.mhfrough.swoop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Swoop capture",
        "url": "overlay.html",
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Screenshots: select, mark up, save",
    "longDescription": "Swoop sits in the tray. Press Print Screen, drag over any part of the screen, add arrows, boxes, text, numbered steps or blur, then copy or save. Nothing is uploaded.",
    "copyright": "Copyright 2026 Mohammad Hamza. MIT licence.",
    "homepage": "https://mhfrough.github.io/swoop/",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": { "section": "graphics" }
    }
  }
}
