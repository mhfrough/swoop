{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swoop",
  "version": "0.1.3",
  "identifier": "dev.mhfrough.swoop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Swoop capture",
        "url": "overlay.html",
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Swoop: screenshots that stay on your computer",
    "longDescription": "Swoop is a tiny, free screenshot app for Windows and Linux. It waits in the tray: press Print Screen, drag over any part of the screen, mark it up with arrows, boxes, ellipses, lines, pen, highlighter, text, numbered steps, blur and crop, then copy or save. No account, no watermark, and nothing is uploaded.",
    "copyright": "© 2026 mhfrough (Mohammad Hamza). MIT licence.",
    "license": "MIT",
    "homepage": "https://mhfrough.github.io/swoop/",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "template": "installer/installer.nsi",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "section": "graphics",
        "desktopTemplate": "installer/swoop.desktop"
      },
      "rpm": {
        "desktopTemplate": "installer/swoop.desktop"
      }
    },
    "publisher": "mhfrough"
  }
}
