{
  "manifest_version": 3,
  "name": "Swoop: full page screenshot",
  "short_name": "Swoop",
  "version": "0.1.0",
  "description": "Capture a whole web page as one image, then mark it up and save it. Nothing is uploaded.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Capture the whole page (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "unlimitedStorage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture the whole page"
    },
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Capture the visible part of the page"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
